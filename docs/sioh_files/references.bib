@article{ost_end_2009,
    title = {The {End} of {Postcommunism}. {Trade} {Unions} in {Eastern} {Europe}’s {Future}},
    volume = {23},
    issn = {0888-3254, 1533-8371},
    url = {https://www.ceeol.com/search/article-detail?id=908420},
    abstract = {Following a long period in which labor in Eastern Europe had been marginalized, often with unionists’ complicity, five conditions now favor revival: survival imperatives of the union bureaucracy, incorporation into the European Union, emerging international solidarity, a new generation of workers, and the end of postcommunism in the firm, or the dismissal of unessential workers. This article focuses on subjective factors: union officials’ own misgivings about unions in the postcommunist era and their revived interest now that they no longer need to defend the unskilled. Yet three factors work against union revival: ideological (continued distrust of unions), organizational (plethora of small firms), and structural (location in the global economy). Labor is likely to remain weak, with a few stronger unions emerging that are more elitist, male, “producerist,” and less class oriented. Legacies continue to be the major problem, but in a twist, the problem today is the legacy not of communism but of postcommunism.},
    language = {English},
    number = {01},
    urldate = {2025-08-31},
    journal = {East European Politics and Societies},
    author = {Ost, David},
    year = {2009},
    note = {Publisher: SAGE Publications Ltd},
    keywords = {industrial relations, labor, postcommunism, trade unions},
    pages = {13--33},
}
@article{emanuele_does_2020,
    title = {Does the {Iron} {Curtain} {Still} {Exist}? {The} {Convergence} in {Electoral} {Volatility} between {Eastern} and {Western} {Europe}},
    volume = {55},
    issn = {0017-257X, 1477-7053},
    shorttitle = {Does the {Iron} {Curtain} {Still} {Exist}?},
    url = {https://www.cambridge.org/core/journals/government-and-opposition/article/does-the-iron-curtain-still-exist-the-convergence-in-electoral-volatility-between-eastern-and-western-europe/4424F7C8C0713D5E61A7DF0705B2F528},
    doi = {10.1017/gov.2018.25},
    abstract = {The literature on party system change and electoral volatility in post-communist Europe tends to make a clear-cut distinction between Central and Eastern European (CEE) party systems and Western European (WE) ones. The former are unstable and unpredictable and electoral volatility is driven by the continuous emergence of new political parties. Conversely, electoral stability is the rule in the latter, and volatility is associated with electoral shifts among established parties. This conventional wisdom suffers from three potential sources of bias: case selection, time coverage and method. By correcting these biases, this article investigates whether the traditional division between CEE and WE party systems has been levelled as regards volatility. To do so, it presents evidence based on an original data set of electoral volatility and its internal components covering 31 WE and CEE party systems since 1990. It finds that a process of asymmetric convergence in the levels of electoral volatility is taking place between the two regions, with Western Europe approaching Central and Eastern Europe with increasing electoral instability.},
    language = {en},
    number = {2},
    urldate = {2025-08-31},
    journal = {Government and Opposition},
    author = {Emanuele, Vincenzo and Chiaramonte, Alessandro and Soare, Sorina},
    month = apr,
    year = {2020},
    keywords = {Central and Eastern Europe, Western Europe, convergence, electoral volatility, party systems},
    pages = {308--326},
}
@article{rovny_stepping_2017,
    title = {Stepping in the same river twice: {Stability} amidst change in {Eastern} {European} party competition},
    volume = {56},
    copyright = {http://onlinelibrary.wiley.com/termsAndConditions\#vor},
    issn = {0304-4130, 1475-6765},
    shorttitle = {Stepping in the same river twice},
    url = {https://ejpr.onlinelibrary.wiley.com/doi/10.1111/1475-6765.12163},
    doi = {10.1111/1475-6765.12163},
    abstract = {Party competition in Eastern Europe faces a seeming paradox. On the one hand, research finds increased political volatility in these countries, while, on the other, some authors demonstrate inherent ideological stability in the region. This research note presents a new methodological approach to adjudicating between these two findings, and suggests that while political organisations come and go, the ideological structure of party competition in Eastern Europe is strikingly steady. By developing a number of different measures of the dimensional structure of party competition, the consistency of the measures across countries, as well as their relative stability within countries over time, is demonstrated. The findings speak to current developments in Eastern Europe, and have implications beyond the region. The conclusion that even volatile party systems can be underpinned by stable ideological oppositions points to two different types of party system structure: one related to parties as organisations, and the other related to parties as expressions of political divides.},
    language = {en},
    number = {1},
    urldate = {2025-08-30},
    journal = {European Journal of Political Research},
    author = {Rovny, Jan and Polk, Jonathan},
    month = feb,
    year = {2017},
    pages = {188--198},
}
