  keywords = {Alleles,Black or African American,Black People,Erythrocytes,Gene Frequency,Genes,Hexokinase,Humans,Hydrogen-Ion Concentration,Pedigree,Phenotype,Phosphotransferases,Temperature,United States,White People}
