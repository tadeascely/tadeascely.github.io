@article{svolikVotingAutocracy2023,
  title = {Voting {{Against Autocracy}}},
  author = {Svolik, Milan W.},
  date = {2023},
  journaltitle = {World Politics},
  volume = {75},
  number = {4},
  pages = {647--691},
  publisher = {Johns Hopkins University Press},
  url = {https://muse.jhu.edu/pub/1/article/908772},
  urldate = {2024-07-07},
  abstract = {, abstract:, When and how do voters punish politicians for subverting democracy? To investigate the role of the public in democratic backsliding, I develop a conceptual framework that differentiates among three mechanisms: vote switching, backlash, and disengagement. The first mechanism entails defection by voters from a candidate who undermines democracy to one who does not; the latter two mechanisms entail transitions between voting and abstention. I estimate the magnitude of each mechanism by combining evidence from a series of original survey experiments, traditional surveys, and a quasi-experiment afforded by the rerun of the 2019 Istanbul mayoral election, in which the governing party, akp, attempted to overturn the result of an election that it had lost. I find that although vote switching and backlash contributed to the akp's eventual defeat the most, each of the three mechanisms served as a democratic check in some subset of the Istanbul electorate. Persuasion, mobilization, and even demobilization are all viable tools for curbing the authoritarian tendencies of elected politicians.}
}

@article{svolikWhenPolarizationTrumps2020,
  title = {When {{Polarization Trumps Civic Virtue}}: {{Partisan Conﬂict}} and the {{Subversion}} of {{Democracy}} by {{Incumbents}}},
  author = {Svolik, Milan W},
  date = {2020},
  journaltitle = {Quarterly Journal of Political Science},
  volume = {15},
  pages = {3--31},
  abstract = {We propose an explanation for the most prevalent form of democratic breakdown after the Cold War: the subversion of democracy by incumbents. In both democratization research and democracy promotion practice, the public is assumed to serve as a check on incumbents’ temptations to subvert democracy. We explain why this check fails in polarized societies. When polarization is high, voters have a strong preference for their favorite candidate, which makes it costly for them to punish an incumbent by voting for a challenger. Incumbents exploit this lack of credible punishment by manipulating the democratic process in their favor. Our analysis of an original survey experiment conducted in Venezuela demonstrates that voters in polarized societies are indeed willing to trade off democratic principles for partisan interests and that their willingness to do so increases in the intensity of their partisanship. These ∗I would like to thank Kate Baldwin, Dawn Brancati, Ethan Bueno de Mesquita, Jennifer Gandhi, Yue Hou, Dorothy Kronick, Ana de la O, Virginia Oliveiros, Carlo Prato, Eli Rau, Arturas Rozenas, Matthew Singer, Susan Stokes, Katerina Tertytchnaya, Rory Truex, Georg Vanberg, David Waldner, Bonnie Weir, and audiences at Chicago, Columbia, Duke, Emory, HSE, LSE, Oxford, Penn State, Rochester, U Penn, USC, Virginia, Warwick, and Yale for helpful comments and conversations. For excellent research assistance, I would like to thank Stephen Feagin, Daniel Goldstein, Constantine Manda, Eli Rau, Metincan Suran, and especially Consuelo Amat Matus who assisted with survey design and supervised the pilot study in Caracas in the fall of 2016. This research was supported by the Whitney and Betty MacMillan Center for International and Area Studies at Yale.}
}

