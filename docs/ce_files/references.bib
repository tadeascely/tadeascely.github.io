@incollection{havlikMethodsPoliticalScience2025,
  title = {Methods in {{Political Science Journals}} in “{{Eastern}}” {{Europe}}: {{Catching}} up with the “{{West}}”},
  booktitle = {The {{Application}} of {{Political Science Methods}} in {{Europe}}: {{A Multifaceted Dilemma}}},
  author = {Havlík, Vlastimil and Kapidžić, Damir and Solska, Magdalena},
  editor = {Verzichelli, Luca and Wagemann, Claudius},
  date = {2025},
  pages = {29--47},
  publisher = {Springer Nature Switzerland},
  location = {Cham},
  doi = {10.1007/978-3-031-93841-2_2},
  url = {https://doi.org/10.1007/978-3-031-93841-2_2},
  urldate = {2025-12-08},
  abstract = {This chapter examines the methodological evolution of political science journals in Eastern Europe since the fall of communism, assessing their progress toward methodological rigor and internationalization. Drawing on an original dataset of articles published in seven leading national political science journals between 2000 and 2019, we analyze trends in the use of research methods, methodological transparency, and data sources. The findings indicate a steady increase in methodological sophistication, with greater emphasis on explicit method descriptions, dedicated methods sections, and the use of new empirical data. However, qualitative approaches, particularly single-case studies, continue to dominate, despite a growing adoption of quantitative methods over time. The chapter contributes to the broader discussion on the professionalization and internationalization of political science in post-communist Europe.},
  isbn = {978-3-031-93841-2}
}

@article{hawkinsChavezPopulistMeasuring2009,
  title = {Is {{Chávez Populist}}?: {{Measuring Populist Discourse}} in {{Comparative Perspective}}},
  author = {Hawkins, Kirk A.},
  date = {2009-08},
  journaltitle = {Comparative Political Studies},
  volume = {42},
  number = {8},
  pages = {1040--1067},
  doi = {10.1177/0010414009331721},
  url = {http://journals.sagepub.com/doi/10.1177/0010414009331721},
  urldate = {2024-02-16},
  abstract = {This article pushes forward our understanding of populism by developing one of the more underappreciated definitions of populism, populism as discourse. It does so by creating a quantitative measure of populist discourse suitable for cross-country and historical analysis. The article starts by laying out the discursive definition of populism in the context of existing definitions. It then operationalizes this definition through a holistic grading of speeches by current chief executives and a few historical figures. The result is a data set of elite-level populist discourse in more than 40 current and past governments from a variety of countries across the world, with special focus on Latin America. This measurement has high reliability comparable to standard human-coded content analysis, compares well to common understandings of actual cases of populism, and is a reasonably efficient technique even in small samples.}
}

