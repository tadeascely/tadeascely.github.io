@article{macklinTransnationalNetworkingFar2013a,
  title = {Transnational {{Networking}} on the {{Far Right}}: {{The Case}} of {{Britain}} and {{Germany}}},
  author = {Macklin, Graham},
  date = {2013-01-01},
  journaltitle = {West European Politics},
  volume = {36},
  number = {1},
  pages = {176--198},
  publisher = {Routledge},
  doi = {10.1080/01402382.2013.742756},
  url = {https://doi.org/10.1080/01402382.2013.742756},
  urldate = {2025-02-02},
  abstract = {This article examines an aspect of transnational activity that is often neglected, namely the transnational activism of the far right. It uses a case study of the British National Party (BNP) and the Nationaldemokratische Partei Deutschlands (NPD – German National Democratic Party) in order to explore how its leaders and activists share ideas and information, policy and praxis, and how this is employed in the development of a strategic ‘master frame’ that they believe will allow them to overcome the limits of purely national activity in a globalised world. It explores the evolution of the links between the two parties, their nature and indeed the limits of such transnational activism upon national ‘frames’ in order to present a historical overview of the diffusion of ideology and strategy within the contemporary European far right.}
}

