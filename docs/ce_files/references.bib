@article{stolleAffectivePolarizationWillingness,
  title = {Affective {{Polarization}} and the {{Willingness}} to {{Accept Executive Aggrandizement Abstract}}:},
  author = {Stolle, Dietlind and Bergeron-Boutin, Olivier and Gidengil, Elisabeth},
  abstract = {Does affective polarization influence citizens’ willingness to condone executive aggrandizement? The literature suggests that affective polarization threatens democracy because partisans are willing to tolerate democratic violations by their party to prevent their disliked party gaining power. However, the evidence is mixed and mostly derived from the United States. We employ two samples of 16 European countries and an additional sample of 11 European countries as well as multiple measures of affective polarization. In addition, we test potential mechanisms in this relationship between affective polarization and support for executive aggrandizement. We show that polarization of partisans of the incumbent party is associated with support of executive aggrandizement mostly in countries where the logic of two-party systems is institutionalized in the form, for example, of a one-party government. The article contributes new insights into the consequences of affective polarization beyond the US context.}
}

