@article{lipsitzPlayingEmotionsEffect2018,
  title = {Playing with {{Emotions}}: {{The Effect}} of {{Moral Appeals}} in {{Elite Rhetoric}}},
  author = {Lipsitz, Keena},
  date = {2018-03-01},
  journaltitle = {Political Behavior},
  volume = {40},
  number = {1},
