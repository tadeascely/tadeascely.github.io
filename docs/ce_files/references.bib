@book{daveigaBasicsTrendsSensitivity2021,
  title = {Basics and Trends in Sensitivity Analysis: Theory and Practice in {{R}}},
  author = {Da Veiga, Sébastien and Gamboa, Fabrice and Iooss, Bertrand and Prieur, Clémentine},
  date = {2021},
