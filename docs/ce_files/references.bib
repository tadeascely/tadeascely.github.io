@article{voelkelMegastudyTesting252024,
  title = {Megastudy Testing 25 Treatments to Reduce Antidemocratic Attitudes and Partisan Animosity},
  author = {Voelkel, Jan G. and Stagnaro, Michael N. and Chu, James Y. and Pink, Sophia L. and Mernyk, Joseph S. and Redekopp, Chrystal and Ghezae, Isaias and Cashman, Matthew and Adjodah, Dhaval and Allen, Levi G. and Allis, L. Victor and Baleria, Gina and Ballantyne, Nathan and Van Bavel, Jay J. and Blunden, Hayley and Braley, Alia and Bryan, Christopher J. and Celniker, Jared B. and Cikara, Mina and Clapper, Margarett V. and Clayton, Katherine and Collins, Hanne and DeFilippis, Evan and Dieffenbach, Macrina and Doell, Kimberly C. and Dorison, Charles and Duong, Mylien and Felsman, Peter and Fiorella, Maya and Francis, David and Franz, Michael and Gallardo, Roman A. and Gifford, Sara and Goya-Tocchetto, Daniela and Gray, Kurt and Green, Joe and Greene, Joshua and Güngör, Mertcan and Hall, Matthew and Hecht, Cameron A. and Javeed, Ali and Jost, John T. and Kay, Aaron C. and Kay, Nick R. and Keating, Brandyn and Kelly, John Michael and Kirk, James R. G. and Kopell, Malka and Kteily, Nour and Kubin, Emily and Lees, Jeffrey and Lenz, Gabriel and Levendusky, Matthew and Littman, Rebecca and Luo, Kara and Lyles, Aaron and Lyons, Ben and Marsh, Wayde and Martherus, James and Maurer, Lauren Alpert and Mehl, Caroline and Minson, Julia and Moore, Molly and Moore-Berg, Samantha L. and Pasek, Michael H. and Pentland, Alex and Puryear, Curtis and Rahnama, Hossein and Rathje, Steve and Rosato, Jay and Saar-Tsechansky, Maytal and Almeida Santos, Luiza and Seifert, Colleen M. and Shariff, Azim and Simonsson, Otto and Spitz Siddiqi, Shiri and Stone, Daniel F. and Strand, Palma and Tomz, Michael and Yeager, David S. and Yoeli, Erez and Zaki, Jamil and Druckman, James N. and Rand, David G. and Willer, Robb},
  date = {2024-10-18},
  journaltitle = {Science},
  volume = {386},
  number = {6719},
  pages = {eadh4764},
  publisher = {American Association for the Advancement of Science},
  doi = {10.1126/science.adh4764},
  url = {https://www.science.org/doi/abs/10.1126/science.adh4764},
  urldate = {2025-03-13},
  abstract = {Scholars warn that partisan divisions in the mass public threaten the health of American democracy. We conducted a megastudy (n = 32,059 participants) testing 25 treatments designed by academics and practitioners to reduce Americans’ partisan animosity and antidemocratic attitudes. We find that many treatments reduced partisan animosity, most strongly by highlighting relatable sympathetic individuals with different political beliefs or by emphasizing common identities shared by rival partisans. We also identify several treatments that reduced support for undemocratic practices—most strongly by correcting misperceptions of rival partisans’ views or highlighting the threat of democratic collapse—which shows that antidemocratic attitudes are not intractable. Taken together, the study’s findings identify promising general strategies for reducing partisan division and improving democratic attitudes, shedding theoretical light on challenges facing American democracy.}
}

