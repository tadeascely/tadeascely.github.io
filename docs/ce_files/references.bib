  doi = {10.2139/ssrn.4105625},
  url = {https://www.ssrn.com/abstract=4105625},
  urldate = {2024-08-29},
  abstract = {When thinking about the intensity of political con‡icts we need to distinguish the part that is due to the distribution of public opinion from the part that is due to the proposals to deal with particular con‡icts that are present on the political agenda. Political con‡icts do not emanate automatically from distributions of preferences. They are activated and structured by policy proposals o¤ered to resolve particular issues. Political polarization cannot be read either from distributions of individual positions or from positions of political parties alone: it depends on both. Moreover, utility distances between di¤erent positions matter and they cannot be always identi…ed.}
