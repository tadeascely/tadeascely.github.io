  title = {How {{People Organize}} the {{Political World}}: {{A Schematic Model}}},
  author = {Conover, Pamela Johnston and Feldman, Stanley},
  date = {1984},
  journaltitle = {American Journal of Political Science},
  volume = {28},
  number = {1},
