@article{lyonsSelfAffirmationIdentityDrivenPolitical2022,
  title = {Self-{{Affirmation}} and {{Identity-Driven Political Behavior}}},
  author = {Lyons, Benjamin A. and Farhart, Christina E. and Hall, Michael P. and Kotcher, John and Levendusky, Matthew and Miller, Joanne M. and Nyhan, Brendan and Raimi, Kaitlin T. and Reifler, Jason and Saunders, Kyle L. and Skytte, Rasmus and Zhao, Xiaoquan},
