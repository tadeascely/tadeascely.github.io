@article{gelmanTwoTruthsLie2022,
  title = {“{{Two Truths}} and a {{Lie}}” as a {{Class-Participation Activity}}},
  author = {Gelman, Andrew},
  date = {2022-04-28},
  journaltitle = {The American Statistician},
  pages = {1--5},
